# Copy to .env and fill in values. Never commit .env.

# Required for Phase 1 (research + content)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: second key for extra quota; used automatically when first key hits 429
# GEMINI_API_KEY_2=your_second_gemini_api_key
TOPIC_FOCUS=AI, Agent AI, Gen AI – releases, comparisons, advancements

# Optional: generate an image for the post (Gemini image model). Set to 1 to enable.
# ENABLE_IMAGE_GENERATION=0

# Phase 2 – Gmail
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=

# Phase 3 – LinkedIn (post on Approve). Run scripts/linkedin_oauth.py once to get refresh token.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REFRESH_TOKEN=
# LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
